<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>dreams25 - AI Hackathon</title>
    <style>
        /* Variables de thème (Style Cyberpunk / Néon) */
        :root {
            --bg-color: #0a0a16;
            --text-color: #00ffff;
            --accent-color: #ff007f;
            --card-bg: rgba(255, 255, 255, 0.05);
            --neon-shadow: 0 0 10px #00ffff, 0 0 20px #00ffff;
        }

        [data-theme="light"] {
            --bg-color: #f0f0f8;
            --text-color: #120136;
            --accent-color: #9d00ff;
            --card-bg: rgba(0, 0, 0, 0.05);
            --neon-shadow: 0 0 10px #9d00ff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            transition: all 0.3s ease;
        }

        body {
            background: linear-gradient(135deg, var(--bg-color), #1a0033);
            color: var(--text-color);
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Barre de navigation / Options */
        header {
            width: 100%;
            max-width: 800px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
        }

        .btn {
            background: transparent;
            border: 2px solid var(--accent-color);
            color: var(--accent-color);
            padding: 10px 20px;
            cursor: pointer;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 0 5px var(--accent-color);
        }

        .btn:hover {
            background: var(--accent-color);
            color: #fff;
            box-shadow: 0 0 15px var(--accent-color);
        }

        /* Section Principale (Hero) */
        .hero {
            text-align: center;
            margin: 40px 0;
            max-width: 800px;
        }

        h1 {
            font-size: 3rem;
            margin-bottom: 10px;
            text-shadow: var(--neon-shadow);
        }

        /* Compte à rebours */
        .timer-container {
            background: var(--card-bg);
            border: 1px solid var(--text-color);
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            width: 100%;
            max-width: 500px;
            text-align: center;
        }

        .timer {
            font-size: 2rem;
            font-weight: bold;
            letter-spacing: 2px;
            margin-top: 10px;
        }

        /* Fenêtre Modale */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-content {
            background: var(--bg-color);
            border: 3px solid var(--accent-color);
            padding: 30px;
            border-radius: 10px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--accent-color);
        }
    </style>
</head>
<body>

    <header>
        <div id="greeting">Chargement...</div>
        <button class="btn" id="theme-toggle">Changer de thème</button>
    </header>

    <main class="hero">
        <h1>dreams25</h1>
        <p>Le Hackathon IA du futur connecté. Créez, codez, surpassez-vous.</p>
        
        <div class="timer-container">
            <h3>Lancement du Hackathon dans :</h3>
            <div class="timer" id="countdown">00:00:00:00</div>
        </div>

        <button class="btn" id="open-modal-btn">En savoir plus</button>
    </main>

    <!-- Structure de la Modale -->
    <div class="modal" id="info-modal">
        <div class="modal-content">
            <span class="close-modal" id="close-modal-btn">&times;</span>
            <h2>À propos de dreams25</h2>
            <br>
            <p>Ce hackathon virtuel regroupe les meilleurs développeurs IA. 48 heures de code intensif sans interruption avec un style 100% cyberpunk.</p>
        </div>
    </div>

    <script>
        // 1. Salutations dynamiques selon l'heure
        const greetingDiv = document.getElementById('greeting');
        const hour = new Date().getHours();
        if (hour < 12) {
            greetingDiv.textContent = "🌅 Bon matin !";
        } else if (hour < 18) {
            greetingDiv.textContent = "☀️ Bonjour !";
        } else {
            greetingDiv.textContent = "🌙 Bonsoir !";
        }

        // 2. Gestion du Thème Clair / Sombre
        const themeToggle = document.getElementById('theme-toggle');
        themeToggle.addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', newTheme);
        });

        // 3. Compte à rebours fonctionnel (Simulation : 5 jours à partir de maintenant)
        const targetDate = new Date().getTime() + (5 * 24 * 60 * 60 * 1000);
        const countdownElement = document.getElementById('countdown');

        setInterval(() => {
            const now = new Date().getTime();
            const difference = targetDate - now;

            const days = Math.floor(difference / (1000 * 60 * 60 * 24));
            const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((difference % (1000 * 60)) / 1000);

            countdownElement.textContent = `${days}j ${hours}h ${minutes}m ${seconds}s`;
        }, 1000);

        // 4. Gestion de la Fenêtre Modale
        const modal = document.getElementById('info-modal');
        const openBtn = document.getElementById('open-modal-btn');
        const closeBtn = document.getElementById('close-modal-btn');

        openBtn.addEventListener('click', () => modal.style.display = 'flex');
        closeBtn.addEventListener('click', () => modal.style.display = 'none');
        window.addEventListener('click', (e) => {
            if (e.target === modal) modal.style.display = 'none';
        });
    </script>
</body>
</html>
